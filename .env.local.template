# ── E-mail (SMTP via Brevo or any provider) ──────────────────
# Brevo (recommended): Dashboard → SMTP & API → SMTP tab
# Host: smtp-relay.brevo.com | Port: 587 | User: your Brevo login email
# Free tier: 300 emails/day — enough for dev/staging
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<your-brevo-login-email>
SMTP_PASS=<brevo-smtp-key>
SMTP_FROM=Flui Contratos <noreply@fluicontratos.com.br>
# Azure Communication Services also works here, by SMTP:
# SMTP_HOST=smtp.azurecomm.net, SMTP_USER/SMTP_PASS from an Entra app (see docs/mensageria.md)

# ── Messaging (RN-08/RN-09) — outbox in PostgreSQL + worker in the API ──
# Every notification is queued in message_outbox and sent by the API itself.
# MESSAGING_POLL_MS=5000          # how often the worker looks at the queue
# MESSAGE_RETENTION_DAYS=30       # sent/failed messages are deleted after this
# MESSAGING_WORKER=off            # keeps this instance from sending (queue only)
# ESCALATION_DAYS=7               # stalled-process alert after N days in the same stage (PROD-05_v2)
# ESCALATION_HOUR=8               # daily check at this hour, Brasília time
# ESCALATION_ENABLED=off          # turns the stalled-process alert off on this instance

# ── Supabase ─────────────────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → API
# The API validates the user token with the anon key and creates/invites
# users with the service role key (never expose it to the frontend).
SUPABASE_URL=<https://your-project-id.supabase.co>
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Found at: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=<supabase-jwt-secret>

# ── Optional ─────────────────────────────────────────────────
# Application Insights — production only
# APPLICATIONINSIGHTS_CONNECTION_STRING=<connection-string>

# Frontend URL — used as redirectTo in Supabase invite emails
# Dev: http://localhost:5173 | Prod: https://your-domain.com
FRONTEND_URL=http://localhost:5173

# ── Frontend (React + Vite) ───────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
# Found at: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=<https://your-project-id.supabase.co>
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
