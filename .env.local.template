# ─────────────────────────────────────────────────────────────
# .env.local — Local development environment variables
# Copy this file to .env.local and fill in every value.
# .env.local is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL (Docker service: postgres) ─────────────────────
POSTGRES_DB=flui_contratos_dev
POSTGRES_USER=flui_admin
POSTGRES_PASSWORD=FluiContratos2026FecapGJ!

# ── n8n (Docker service: n8n) ─────────────────────────────────
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=FluiContratos2026FecapGJ!

# ── Azurite — Azure Storage emulator (Docker service: azurite) ─
# These are the fixed well-known Azurite dev credentials — safe to commit in templates.
AZURITE_ACCOUNT_NAME=devstoreaccount1
AZURITE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==

# ── Backend (NestJS) ──────────────────────────────────────────
NODE_ENV=development

# TypeORM / PostgreSQL connection
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=${POSTGRES_DB}
DATABASE_USER=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}

# Convenience full URL (used by TypeORM if preferred)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# n8n webhook base URL — NestJS calls this on every Kanban stage change (RN-08/RN-09)
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# Azure Blob Storage — Azurite connection string for local dev
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER_NAME=documentos

# ── E-mail (SMTP via Brevo or any provider) ──────────────────
# Brevo (recommended): Dashboard → SMTP & API → SMTP tab
# Host: smtp-relay.brevo.com | Port: 587 | User: your Brevo login email
# Free tier: 300 emails/day — enough for dev/staging
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<your-brevo-login-email>
SMTP_PASS=<brevo-smtp-key>
SMTP_FROM=Flui Contratos <noreply@fluicontratos.com.br>

# ── Supabase ─────────────────────────────────────────────────
# Found at: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=<supabase-jwt-secret>

# Frontend URL — used as redirectTo in Supabase invite emails
# Dev: http://localhost:5173 | Prod: https://your-domain.com
FRONTEND_URL=http://localhost:5173

# ── Frontend (React + Vite) ───────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
# Found at: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=<https://your-project-id.supabase.co>
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
