# ─────────────────────────────────────────────────────────────
# env.azure.template — Azure production environment variables
# Copy to .env.azure at project root and fill every value after running provision.sh.
# .env.azure is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Azure Database for PostgreSQL Flexible Server ─────────────
DATABASE_HOST=<server-name>.postgres.database.azure.com
DATABASE_PORT=5432
DATABASE_NAME=flui_contratos
DATABASE_USER=fluiadmin
DATABASE_PASSWORD=<from-key-vault: flui-kv-dev-fecap/postgres-admin-password>
DATABASE_SSL=true

DATABASE_URL=postgresql://fluiadmin:<password>@<server-name>.postgres.database.azure.com:5432/flui_contratos?sslmode=require

# ── Azure Blob Storage ────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=<from: az storage account show-connection-string --name <account> --resource-group flui-dev>
AZURE_STORAGE_CONTAINER_NAME=documentos

# ── n8n (configure after deploying n8n to Azure Container Apps) ──
N8N_WEBHOOK_BASE_URL=https://<n8n-container-app-fqdn>

# ── Supabase Auth ─────────────────────────────────────────────
SUPABASE_JWT_SECRET=<from Supabase Dashboard → Project Settings → API → JWT Secret>

# ── Azure Application Insights ────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=<from: az monitor app-insights component show --app flui-insights-dev --resource-group flui-dev --query connectionString>

# ── Frontend (injected at Static Web App build time) ─────────
VITE_API_BASE_URL=https://flui-api-dev.azurewebsites.net
VITE_SUPABASE_URL=<from Supabase Dashboard → Project Settings → API → Project URL>
VITE_SUPABASE_ANON_KEY=<from Supabase Dashboard → Project Settings → API → anon/public key>
